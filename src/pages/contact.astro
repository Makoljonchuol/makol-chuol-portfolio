---
import Layout from "../layouts/Layout.astro";

const links = [
  { label: "Email", value: "jchuol@macalester.edu", href: "mailto:jchuol@macalester.edu" },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/makol-jc",
    href: "https://linkedin.com/in/makol-jc",
  },
  {
    label: "GitHub",
    value: "github.com/Makoljonchuol",
    href: "https://github.com/Makoljonchuol",
  },
];
---

<Layout
  title="Contact"
  description="Get in touch with Makol J. Chuol."
>
  <section class="mx-auto max-w-5xl px-6 py-20 sm:px-8 sm:py-28">
    <div class="max-w-xl" data-reveal>
      <p class="text-sm font-medium tracking-wide text-accent uppercase">
        Contact
      </p>
      <h1 class="mt-3 font-serif text-3xl text-ink sm:text-4xl">
        Let's talk.
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">
        Open to opportunities in software engineering and security, and to
        conversations about education and peacebuilding work. Reach out
        directly. I read everything.
      </p>

      <div class="mt-10 flex flex-col divide-y divide-line border-t border-b border-line">
        {
          links.map((l) => (
            <a
              href={l.href}
              target={l.href.startsWith("http") ? "_blank" : undefined}
              rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="group flex items-center justify-between py-5 transition-colors hover:text-accent"
            >
              <span class="text-sm font-medium text-muted group-hover:text-accent">
                {l.label}
              </span>
              <span class="text-base text-ink group-hover:text-accent">
                {l.value}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
